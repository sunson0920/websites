{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/((?!static/|.*\\.[a-z0-9]+$).*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/((?!static/|app/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}